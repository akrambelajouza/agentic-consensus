# Every tunable in the project lives here. Copy to `.env` and edit — no source
# changes needed. Defaults are shown commented out; uncomment to override.
#
# Real environment variables win over this file, so a one-off
# `MAX_ROUNDS=2 uv run consensus "..."` still works.

# --- Credentials -------------------------------------------------------------
# You need a key for each provider you actually route to. OpenRouter reaches both
# Anthropic and OpenAI models with a single key, so it's the shortest path if you
# don't hold accounts with the vendors directly.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- LangSmith Studio and tracing (EU) ---------------------------------------
# Create this key in the EU LangSmith UI: https://eu.smith.langchain.com
# The key is optional for running the local graph, but required to send traces to
# LangSmith and remove Studio's "Not seeing LangSmith runs?" warning.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-consensus
#
# Only set this when the API key can access multiple workspaces. Use the workspace
# ID from Settings -> General, not the organization ID from an `/o/...` URL.
# LANGSMITH_WORKSPACE_ID=
#
# The browser UI host is a CLI option, not an environment variable. Start Studio with:
#   uv run langgraph dev --studio-url https://eu.smith.langchain.com

# --- Model selection ---------------------------------------------------------
# Format: provider:model   (providers: anthropic, openai, openrouter)
#
# Via OpenRouter — one key, Claude author and GPT critic. Both IDs below are
# confirmed to support the JSON-schema structured outputs and the reasoning_effort
# this project depends on. Needs `uv sync --extra openrouter`.
MODERATOR_MODEL=openrouter:anthropic/claude-opus-5
AGENT_A_MODEL=openrouter:anthropic/claude-opus-5
AGENT_B_MODEL=openrouter:openai/gpt-5.5
# Optional. When unset, the independent evaluator inherits Agent B's model.
# EVALUATOR_MODEL=openrouter:openai/gpt-5.5
#
# Direct to the vendor APIs instead (needs ANTHROPIC_API_KEY / OPENAI_API_KEY,
# and `uv sync --extra openai` for the OpenAI ones):
#
# MODERATOR_MODEL=anthropic:claude-opus-5
# AGENT_A_MODEL=anthropic:claude-opus-5
# AGENT_B_MODEL=anthropic:claude-sonnet-5
#
# A bare model name works too — the provider is inferred. A slash means OpenRouter
# (`anthropic/claude-opus-5`), `claude*` means anthropic, `gpt-*` means openai.

# --- Loop control ------------------------------------------------------------
# MAX_ROUNDS: author->reviewer rounds before giving up. Each round is 2 model
# calls, so a run costs `1 + 2*MAX_ROUNDS + 1` calls. Use 2 while iterating on
# prompts. Minimum 1.
# MAX_ROUNDS=4
#
# STALL_PATIENCE: consecutive non-improving review scores that end the loop
# early. 1 bails the moment a round fails to improve (cheapest, but cuts off
# genuine slow progress); raise it if your reviewer's scores are noisy.
# STALL_PATIENCE=2

# --- Token budgets -----------------------------------------------------------
# Agent A gets double: it writes the full deliverable every round, while the
# other two roles emit a short structured object or a synthesis.
#
# On Claude these cap thinking PLUS visible output, and adaptive thinking is on
# by default — a budget sized only for the answer will truncate mid-sentence.
# Minimum 256.
#
# MODERATOR_MAX_TOKENS=8000
# AGENT_A_MAX_TOKENS=16000
# AGENT_B_MAX_TOKENS=8000
# EVALUATOR_MAX_TOKENS=8000  # inherits Agent B when unset

# --- Reasoning effort --------------------------------------------------------
# Passed through as `reasoning_effort`. Accepted values:
#   anthropic:  low | medium | high | xhigh | max
#   openai:     minimal | low | medium | high
#   openrouter: all six
# Set any of them — a value the target provider doesn't accept is folded onto
# its nearest supported neighbour, so swapping providers never breaks a run.
#
# Dropping the reviewer to `medium` is the cheapest meaningful saving: it grades
# against fixed criteria and doesn't need the author's horsepower.
#
# MODERATOR_EFFORT=high
# AGENT_A_EFFORT=high
# AGENT_B_EFFORT=high
# EVALUATOR_EFFORT=high  # inherits Agent B when unset

# --- Web UI run history -------------------------------------------------------
# SQLite file the web UI (`consensus-web`) persists completed runs to, for the
# History page. Irrelevant to the CLI/Studio.
#
# CONSENSUS_DB_PATH=consensus.db
